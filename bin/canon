#!/usr/bin/env sh
# 実行中の OS・CPU に合う canon バイナリを呼ぶ起動スクリプト。
# フックや MCP の設定からはこのスクリプトを呼ぶ。
dir=$(cd "$(dirname "$0")" && pwd)
case "$(uname -s)" in
  Linux*) os=linux ;;
  Darwin*) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *) echo "canon: 未対応の OS です: $(uname -s)" >&2; exit 2 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) echo "canon: 未対応の CPU です: $(uname -m)" >&2; exit 2 ;;
esac
ext=""; [ "$os" = "windows" ] && ext=".exe"
bin="$dir/canon-$os-$arch$ext"
if [ ! -x "$bin" ] && [ ! -f "$bin" ]; then
  echo "canon: バイナリがありません: $bin（tools/build.sh でビルドしてください）" >&2
  exit 2
fi
exec "$bin" "$@"
